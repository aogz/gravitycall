{
    "name": "Gravity Call",
    "version": "1.0.0",
    "manifest_version": 3,
    "short_name": "Gravity Call",
    "start_url": "/",
    "display": "standalone",
    "background_color": "#000000",
    "theme_color": "#000000",
    "host_permissions": [
        "https://gravitycall.aogz.me/*",
        "https://*.opentok.com/*",
        "https://*.tokbox.com/*",
        "wss://*.opentok.com/*",
        "wss://*.tokbox.com/*",
        "https://api.elevenlabs.io/*",
        "wss://api.elevenlabs.io/*",
        "https://11.aogz.me/*",
        "https://esm.sh/*"
    ],
    "action": {
        "default_popup": "index.html",
        "default_icon": {
            "24": "icon.svg"
        }
    }
}
